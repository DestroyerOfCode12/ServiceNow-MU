# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/csa_platform?schema=public"

# Only needed when DATABASE_URL points at a connection-pooled endpoint (e.g.
# Neon's "-pooler" host, PgBouncer in transaction-pooling mode) — Prisma's
# `migrate deploy` takes a session-level advisory lock that a pooled
# connection can't reliably hold, and fails with P1002 ("timed out trying to
# acquire a postgres advisory lock"). DIRECT_URL routes migrations only
# through the database's direct/unpooled endpoint instead; the app's normal
# query traffic still goes through the pooled DATABASE_URL above. Not
# needed against a plain, unpooled Postgres instance (e.g. local dev).
# DIRECT_URL="postgresql://user:password@localhost:5432/csa_platform?schema=public"

# Auth.js (NextAuth v5) secret - generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: the canonical production origin (no trailing slash), used to
# build absolute URLs for metadata, robots.txt, sitemap.xml, and Open Graph
# tags. Falls back to the current Netlify domain if unset — only needs to be
# set if you're on a custom domain.
# NEXT_PUBLIC_SITE_URL="https://servicenow-csa-prep.netlify.app"

# Optional: credentials for the initial admin account created by `npm run db:seed`
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# Optional: OAuth sign-in providers. Each is entirely opt-in — leave a
# provider's vars unset and it simply won't show a button on the login page;
# email/password sign-in keeps working either way. See README/setup docs for
# how to register each app and what redirect URL to give it.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""  # optional — omit to allow any Microsoft account (personal/school/work)
