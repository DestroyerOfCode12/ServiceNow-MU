# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/csa_platform?schema=public"

# Auth.js (NextAuth v5) secret - generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: credentials for the initial admin account created by `npm run db:seed`
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# Optional: OAuth sign-in providers. Each is entirely opt-in — leave a
# provider's vars unset and it simply won't show a button on the login page;
# email/password sign-in keeps working either way. See README/setup docs for
# how to register each app and what redirect URL to give it.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""  # optional — omit to allow any Microsoft account (personal/school/work)
